# Copernus configuration. Units in names, no secrets in defaults.
COP_ENV=development
COP_LOG_LEVEL=INFO

# Postgres (compose.yaml provides this locally: make db-up)
COP_DATABASE_URL=postgresql+asyncpg://copernus:copernus@localhost:5433/copernus

# Auth
COP_AUTH_EMAIL_DOMAIN=example.com
COP_SESSION_TTL_HOURS=12
COP_SESSION_COOKIE_SECURE=false   # true in production (HTTPS only)

# Migration/bootstrap role (owns DDL; the app role gets no DELETE on audit_log)
COP_MIGRATION_DATABASE_URL=postgresql+asyncpg://copernus:copernus@localhost:5433/copernus
